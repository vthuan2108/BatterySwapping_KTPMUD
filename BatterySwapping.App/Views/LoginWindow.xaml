<Window x:Class="BatterySwapping.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Hệ Thống Trạm Đổi Pin Xe Máy Điện (BSS)" 
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Logo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <!-- Biểu tượng trạm pin năng lượng xanh -->
            <Border Width="64" Height="64" CornerRadius="32" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="⚡" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
            <TextBlock Text="BATTERY SWAPPING SYSTEM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Học phần: Kỹ thuật Phần mềm Ứng dụng (KTPMUD)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="Hệ thống Quản lý Mạng lưới Tủ Đổi Pin Tự Động" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form Đăng nhập -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="24,20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBoxStyle}" Text="admin" Margin="0,0,0,14"/>

                <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBoxStyle}" Password="123456" Margin="0,0,0,10"/>

                <!-- Thông báo lỗi nếu có -->
                <TextBlock x:Name="lblError" Text="" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Nút Đăng nhập -->
                <Button x:Name="btnLogin" Content="ĐĂNG NHẬP QUẢN TRỊ" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click" Height="42" Margin="0,0,0,10"/>

                <!-- Nút Vào thẳng Kiosk đổi pin -->
                <Button x:Name="btnKioskDirect" Content="Mở Màn Hình Kiosk Tại Trạm" Style="{StaticResource OutlineButtonStyle}" Click="BtnKioskDirect_Click" Height="38"/>

                <!-- Gợi ý tài khoản demo -->
                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Margin="0,15,0,0">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16">
                        <Bold>Tài khoản demo:</Bold><LineBreak/>
                        • Admin: <Run Text="admin" FontWeight="SemiBold"/> | Mật khẩu: <Run Text="123456" FontWeight="SemiBold"/><LineBreak/>
                        • Kỹ thuật: <Run Text="tech01" FontWeight="SemiBold"/> | Mật khẩu: <Run Text="123456" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Cấu hình chuỗi kết nối SQL Server -->
        <Expander Grid.Row="2" Header="Cấu hình kết nối SQL Server (Click để chỉnh sửa)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0">
            <StackPanel Margin="0,6,0,0">
                <TextBox x:Name="txtConnString" FontSize="11" Style="{StaticResource ModernTextBoxStyle}" Height="30" Padding="6,4"/>
                <Button Content="Kiểm tra kết nối CSDL" Style="{StaticResource OutlineButtonStyle}" Margin="0,6,0,0" Padding="8,4" FontSize="11" Click="BtnTestConnection_Click"/>
            </StackPanel>
        </Expander>
    </Grid>
</Window>
