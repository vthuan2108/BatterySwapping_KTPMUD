<Window x:Class="BatterySwapping.App.Views.Dialogs.AddBatteryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Pin Mới Vào Kho Hệ Thống" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="THÊM PIN MỚI VÀO HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="Mã định danh Pin (Ví dụ: PIN-013)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMaPin" Style="{StaticResource ModernTextBoxStyle}" Text="PIN-013" Margin="0,0,0,10"/>

                <TextBlock Text="Loại Pin" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtLoaiPin" Style="{StaticResource ModernTextBoxStyle}" Text="Lithium LFP 72V-30Ah" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Dung lượng (%)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoC" Style="{StaticResource ModernTextBoxStyle}" Text="100.0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Sức khỏe (%)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoH" Style="{StaticResource ModernTextBoxStyle}" Text="100.0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Nhiệt độ (°C)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNhietDo" Style="{StaticResource ModernTextBoxStyle}" Text="26.0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Điện áp (V)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDienAp" Style="{StaticResource ModernTextBoxStyle}" Text="72.6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy bỏ" Style="{StaticResource OutlineButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Content="Lưu Pin Mới" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
