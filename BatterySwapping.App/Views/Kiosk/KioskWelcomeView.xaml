<UserControl x:Class="BatterySwapping.App.Views.Kiosk.KioskWelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner Chào mừng Kiosk -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" Padding="30,24">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⚡ TRẠM ĐỔI PIN TỰ ĐỘNG - BATTERY SWAPPING KIOSK" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Đổi pin siêu nhanh trong 1 phút • An toàn tuyệt đối • Năng lượng xanh tương lai" FontSize="14" Foreground="#A7F3D0" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Khung quét mã / Nhập thông tin khách hàng -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Width="520" Margin="0,30" VerticalAlignment="Top" HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="28" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="📱" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="XÁC THỰC TÀI XẾ ĐỔI PIN" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Vui lòng nhập Số điện thoại hoặc quét Mã QR trên App người dùng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <TextBlock Text="Số điện thoại / Mã định danh QR" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="txtPhoneOrQr" Style="{StaticResource ModernTextBoxStyle}" Text="0987654321" Height="44" FontSize="16" Margin="0,0,0,10"/>

                <!-- Thông báo lỗi nếu có -->
                <TextBlock x:Name="lblKioskError" Text="" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Nút Xác thực -->
                <Button x:Name="btnStartSwap" Content="TIẾP TỤC ĐỔI PIN ➔" Style="{StaticResource PrimaryButtonStyle}" Height="46" FontSize="15" Click="BtnStartSwap_Click" Margin="0,0,0,16"/>

                <!-- Chọn nhanh tài xế demo để kiểm thử đồ án -->
                <TextBlock Text="Chọn nhanh tài khoản tài xế demo:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                <Button Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,6" Click="BtnQuickDriver_Click" Tag="0987654321">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 Nguyễn Văn An" FontWeight="Bold"/>
                        <TextBlock Text=" (Ví: 150.000 đ • Trả PIN-009 [18%])" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,6" Click="BtnQuickDriver_Click" Tag="0912345678">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 Trần Thị Bình" FontWeight="Bold"/>
                        <TextBlock Text=" (Ví: 50.000 đ • Trả PIN-010 [12%])" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OutlineButtonStyle}" Click="BtnQuickDriver_Click" Tag="0905112233">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 Lê Hoàng Cường" FontWeight="Bold"/>
                        <TextBlock Text=" (Ví: 10.000 đ • Test lỗi không đủ tiền ví)" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
