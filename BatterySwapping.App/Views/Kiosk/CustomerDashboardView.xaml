<UserControl x:Class="BatterySwapping.App.Views.Kiosk.CustomerDashboardView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="TÀI XẾ VÀ VÍ CỦA TÔI" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
  <TextBlock x:Name="status" Margin="0,8,0,16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="THÔNG TIN TÀI XẾ" FontWeight="Bold"/><TextBlock x:Name="profile" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="15" LineHeight="26"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="VÍ NỘI BỘ" FontWeight="Bold"/><TextBlock x:Name="balance" Margin="0,12,0,8" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/><TextBlock x:Name="available" TextWrapping="Wrap"/><TextBlock Text="Nạp ví demo — không chuyển tiền ngân hàng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,8" TextWrapping="Wrap"/>
    <WrapPanel><Button Content="50.000 đ" Tag="50000" Click="QuickAmount" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,6"/><Button Content="100.000 đ" Tag="100000" Click="QuickAmount" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,6"/><Button Content="200.000 đ" Tag="200000" Click="QuickAmount" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,6"/></WrapPanel>
    <Label Content="Số tiền nạp (đ)" Target="{Binding ElementName=amount}"/><TextBox x:Name="amount" Text="50000" Style="{StaticResource ModernTextBoxStyle}"/><Button x:Name="topup" Content="NẠP THÊM VÀO VÍ DEMO" Click="TopupClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"/>
   </StackPanel></Border>
  </Grid>
  <Button Content="ĐỔI PIN TẠI TRẠM" Click="SwapClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16"/>
  <TabControl Height="300"><TabItem Header="Lịch sử đổi pin"><DataGrid x:Name="swapHistory" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Mã giao dịch" Binding="{Binding MaGD}" Width="100"/><DataGridTextColumn Header="Trạm" Binding="{Binding MaTram}" Width="110"/><DataGridTextColumn Header="Pin trả" Binding="{Binding MaPinTra}" Width="100"/><DataGridTextColumn Header="Pin nhận" Binding="{Binding MaPinNhan}" Width="100"/><DataGridTextColumn Header="Phí (đ)" Binding="{Binding PhiDoiPin, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="*"/><DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGianBatDau, StringFormat='{}{0:dd/MM HH:mm}'}" Width="145"/></DataGrid.Columns></DataGrid></TabItem>
  <TabItem Header="Lịch sử nạp ví"><DataGrid x:Name="topupHistory" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Mã nạp" Binding="{Binding MaNap}" Width="90"/><DataGridTextColumn Header="Số tiền (đ)" Binding="{Binding SoTien, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="Phương thức" Binding="{Binding PhuongThuc}" Width="*"/><DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGian, StringFormat='{}{0:dd/MM HH:mm}'}" Width="160"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
 </StackPanel></ScrollViewer>
</UserControl>
