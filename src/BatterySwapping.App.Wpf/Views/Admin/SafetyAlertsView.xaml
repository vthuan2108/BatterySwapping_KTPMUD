<UserControl x:Class="BatterySwapping.App.Views.Admin.SafetyAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Cảnh báo -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="NHẬT KÝ CẢNH BÁO AN TOÀN IOT &amp; PHÒNG CHÁY NỔ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                <TextBlock Text="Quá nhiệt: khóa 5 phút thực, dưới 35°C; lần 1–2 tự khôi phục, từ lần 3 cần Admin reset" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="chkOnlyUnresolved" Content="Chỉ hiện sự cố chưa xử lý" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkOnlyUnresolved_Changed" Unchecked="ChkOnlyUnresolved_Changed"/>
                <Button Content="🔄 Làm mới" Style="{StaticResource OutlineButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid Cảnh báo -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="dgAlerts" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" Background="White" RowHeight="40" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ CB" Binding="{Binding MaCB}" FontWeight="Bold" Width="70"/>
                    <DataGridTextColumn Header="TRẠM" Binding="{Binding MaTram}" Width="100"/>
                    <DataGridTextColumn Header="NGĂN #" Binding="{Binding MaNgan, TargetNullValue='--'}" Width="80"/>
                    <DataGridTextColumn Header="MÃ PIN" Binding="{Binding MaPin, TargetNullValue='--'}" FontWeight="SemiBold" Width="100"/>
                    <DataGridTextColumn Header="LOẠI SỰ CỐ" Binding="{Binding LoaiCanhBao}" FontWeight="Bold" Width="260"/>
                    <DataGridTextColumn Header="GIÁ TRỊ ĐO" Binding="{Binding GiaTriDo, StringFormat='{}{0:F1} °C'}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Width="100"/>
                    <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding ThoiGianPhatHien, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="150"/>
                    <DataGridTemplateColumn Header="MỨC ĐỘ" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding MauMucDo}" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding MucDoNghiemTrong}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ĐÃ XỬ LÝ?" Binding="{Binding DaXuLyText}" FontWeight="SemiBold" Width="100"/>
                    <DataGridTemplateColumn Header="THAO TÁC" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Kiểm tra / reset" Style="{StaticResource OutlineButtonStyle}" Padding="6,2" FontSize="11"
                                        Click="BtnResolve_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
