<UserControl x:Class="BatterySwapping.App.Views.Admin.OverviewView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Tiêu đề trang & Trạng thái -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="heading" Text="TỔNG QUAN HỆ THỐNG" FontSize="18" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0">
                    <TextBlock Text="MẠNG LƯỚI 2 TRẠM HÀ NỘI" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="status" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 2. Thẻ Card Tóm tắt Chỉ số (Summary Card) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon điểm nhấn góc trái -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" 
                        Background="{StaticResource PrimaryLightBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BÁO CÁO NHANH CHỈ SỐ HOẠT ĐỘNG" FontSize="11" FontWeight="Bold" 
                               Foreground="{StaticResource TextCategoryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="summary" FontSize="15" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="24"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Bảng Danh sách Trạm Pin (DataGrid Card) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header thẻ danh sách -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DANH SÁCH TRẠM ĐỔI PIN TRỰC TUYẾN" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#F3F4F6" CornerRadius="10" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="Bấm đúp để xem chi tiết" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid danh sách -->
                <DataGrid Grid.Row="1" x:Name="stations" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="OpenStation"
                          Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FAFAFA"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ TRẠM" Binding="{Binding MaTram}" Width="140"/>
                        <DataGridTextColumn Header="TÊN TRẠM VÀ VỊ TRÍ" Binding="{Binding TenTram}" Width="*"/>
                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThaiHoatDong}" Width="160"/>
                        <DataGridTextColumn Header="SỐ HỘC PIN" Binding="{Binding SoLuongNgan}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
