<UserControl x:Class="BatterySwapping.App.Views.Admin.SwapSessionsView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="GIAO DỊCH ĐỔI PIN" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="txtStatus" Text="Theo dõi phiên và xử lý các trường hợp cần hỗ trợ." Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
 <WrapPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="filter" Width="200" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Tất cả phiên"/><ComboBoxItem Content="Đang thực hiện"/><ComboBoxItem Content="Cần hỗ trợ"/><ComboBoxItem Content="Đã kết thúc"/></ComboBox><Button Content="Làm mới" Click="RefreshClick" Style="{StaticResource OutlineButtonStyle}" Margin="8,0"/><Button x:Name="resume" Content="Đối soát / Tiếp tục" Click="ResumeClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="cancel" Content="Hủy / Yêu cầu hỗ trợ" Click="CancelClick" Style="{StaticResource OutlineButtonStyle}"/></WrapPanel>
 <DataGrid Grid.Row="2" x:Name="sessions" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Trạm" Binding="{Binding StationId}" Width="100"/><DataGridTextColumn Header="Khách" Binding="{Binding CustomerId}" Width="60"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding StateLabel}" Width="180"/><DataGridTextColumn Header="Pin trả" Binding="{Binding OldBatteryId}" Width="100"/><DataGridTextColumn Header="Pin nhận" Binding="{Binding NewBatteryId}" Width="100"/><DataGridTextColumn Header="Thu phí" Binding="{Binding PaymentLabel}" Width="110"/><DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM HH:mm:ss}'}" Width="*"/></DataGrid.Columns></DataGrid>
 <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" Margin="0,12,0,0"><TextBlock x:Name="detail" Text="Chọn một phiên để xem chi tiết và thao tác được phép." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></Border>
 </Grid>
</UserControl>
