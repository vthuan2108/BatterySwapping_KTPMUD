<UserControl x:Class="BatterySwapping.App.Views.Admin.BatteryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Nút thêm pin -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ DANH MỤC PIN VÀ GIÁM SÁT BMS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Theo dõi tuổi thọ pin (SoH), chu kỳ sạc xả và phát hiện pin chai/quá nhiệt" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🛠️ Kiểm Định / Bảo Trì" Style="{StaticResource OutlineButtonStyle}" Click="BtnMaintainSelected_Click" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <Button x:Name="btnAddBattery" Content="➕ Thêm Pin Mới" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddBattery_Click" Margin="0,0,8,0"/>
                <Button Content="🔄 Làm mới" Style="{StaticResource OutlineButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Bộ lọc tìm kiếm -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" 
                         Text="" TextChanged="TxtSearch_TextChanged" Margin="0,0,12,0"/>
                <TextBlock IsHitTestVisible="False" Text="🔍 Nhập mã pin cần tìm (ví dụ: PIN-001)..." 
                           VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ComboBox x:Name="cboStatusFilter" Grid.Column="1" Height="38" VerticalContentAlignment="Center" SelectionChanged="CboStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="-- Tất cả trạng thái --" IsSelected="True"/>
                    <ComboBoxItem Content="Đã đầy (SoC ≥ 90%)"/>
                    <ComboBoxItem Content="Đang sạc"/>
                    <ComboBoxItem Content="Khả dụng"/>
                    <ComboBoxItem Content="Đang sử dụng"/>
                    <ComboBoxItem Content="Lỗi quá nhiệt"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Bảng danh sách Pin (DataGrid) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="dgBatteries" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" Background="White" RowHeight="36" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      MouseDoubleClick="DgBatteries_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ PIN" Binding="{Binding MaPin}" FontWeight="Bold" Width="90"/>
                    <DataGridTextColumn Header="LOẠI PIN" Binding="{Binding LoaiPin}" Width="150"/>
                    <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding DungLuongThietKe, StringFormat='{}{0} Ah'}" Width="100"/>
                    <DataGridTemplateColumn Header="DUNG LƯỢNG (SoC)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SoC, StringFormat='{}{0:F1}%'}" FontWeight="SemiBold"/>
                                    <ProgressBar Value="{Binding SoC}" Minimum="0" Maximum="100" Height="4" Margin="0,2,0,0"
                                                 Foreground="{Binding MauNhietDo}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SỨC KHỎE (SoH)" Binding="{Binding SoH, StringFormat='{}{0:F1}%'}" Width="110"/>
                    <DataGridTemplateColumn Header="NHIỆT ĐỘ BMS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NhietDo, StringFormat='{}{0:F1} °C'}" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{Binding MauNhietDo}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ĐIỆN ÁP (V)" Binding="{Binding DienAp, StringFormat='{}{0:F1} V'}" Width="85"/>
                    <DataGridTextColumn Header="DÒNG (A)" Binding="{Binding DongDien, StringFormat='{}{0:F1} A'}" Width="80"/>
                    <DataGridTextColumn Header="SỐ LẦN SẠC" Binding="{Binding SoLanSac}" Width="90"/>
                    <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}" FontWeight="SemiBold" Width="*"/>
                    <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🛠️ Kiểm định" Style="{StaticResource OutlineButtonStyle}" 
                                        Padding="6,2" FontSize="11" FontWeight="SemiBold"
                                        Tag="{Binding}" Click="BtnRowMaintain_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
