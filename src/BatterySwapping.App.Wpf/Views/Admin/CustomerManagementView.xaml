<UserControl x:Class="BatterySwapping.App.Views.Admin.CustomerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Nút nạp tiền -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ KHÁCH HÀNG &amp; VÍ ĐIỆN TỬ NỘI BỘ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Tra cứu số dư, phương tiện đăng ký và nạp tiền tài khoản đổi pin" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💳 Nạp Tiền Vào Ví" Style="{StaticResource PrimaryButtonStyle}" Click="BtnTopUp_Click" Margin="0,0,8,0"/>
                <Button Content="🔄 Làm mới" Style="{StaticResource OutlineButtonStyle}" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Tìm kiếm -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBoxStyle}" 
                         Text="" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Text="🔍 Tìm kiếm khách hàng theo tên, số điện thoại hoặc biển số xe..." 
                           VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- DataGrid Khách hàng -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="dgCustomers" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" Background="White" RowHeight="38" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MÃ KH" Binding="{Binding MaKH}" FontWeight="Bold" Width="70"/>
                    <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding HoTen}" FontWeight="SemiBold" Width="180"/>
                    <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding SoDienThoai}" Width="130"/>
                    <DataGridTextColumn Header="BIỂN SỐ XE" Binding="{Binding BienSoXe}" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Width="120"/>
                    <DataGridTextColumn Header="SỐ DƯ VÍ" Binding="{Binding SoDuFormatted}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Width="140"/>
                    <DataGridTextColumn Header="PIN ĐANG MƯỢN" Binding="{Binding MaPinDangMuon, TargetNullValue='[Chưa mượn]'}" Width="140"/>
                    <DataGridTextColumn Header="NGÀY ĐĂNG KÝ" Binding="{Binding NgayDangKy, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                    <DataGridTemplateColumn Header="THAO TÁC" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Nạp tiền" Style="{StaticResource OutlineButtonStyle}" Padding="6,2" FontSize="11" Click="BtnRowTopUp_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
