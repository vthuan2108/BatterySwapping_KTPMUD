<UserControl x:Class="BatterySwapping.App.Views.Admin.StationDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề & Chọn trạm -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BẢNG ĐIỀU KHIỂN &amp; GIÁM SÁT MẠNG LƯỚI TRẠM SẠC IOT" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock x:Name="txtTelemetryStatus" Text="● ĐANG KẾT NỐI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="lblStationAddress" Text="Trạm Đổi Pin ĐH Bách Khoa Hà Nội • Cổng Parabol Giải Phóng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Chọn Trạm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cboStations" Width="200" Height="38" VerticalContentAlignment="Center" SelectionChanged="CboStations_SelectionChanged"/>
                    <Button x:Name="btnAddStation" Content="➕ Thêm Trạm" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Height="38" Click="BtnAddStation_Click"/>
                    <Button Content="🔄 Làm mới" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0" Height="38" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="3" Margin="0,0,0,12" HorizontalAlignment="Right">
                <Button Content="Ngắt sạc trạm đang chọn" Style="{StaticResource DangerButtonStyle}" Click="CutoffClick" Margin="8,0"/>
                <Button Content="Khôi phục trạm" Style="{StaticResource OutlineButtonStyle}" Click="RestoreClick"/>
            </WrapPanel>
            <!-- 4 Thẻ chỉ số tổng quan (KPI Cards) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
                <!-- Card 1: Doanh thu hôm nay -->
                <Border x:Name="revenueCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DOANH THU HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblTodayRevenue" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Đơn giá cố định: 25.000 đ/lượt" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Tổng lượt đổi pin -->
                <Border x:Name="swapCard" Style="{StaticResource CardBorderStyle}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG LƯỢT ĐỔI PIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblTotalSwaps" Text="0 lượt" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Đảm bảo an toàn chu kỳ 100%" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Pin sẵn sàng tại trạm -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="PIN ĐÃ ĐẦY SẴN SÀNG (SoC ≥ 90%)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblReadyBatteries" Text="0 / 8 pin" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Đạt chuẩn nhiệt độ &lt; 45°C" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Cảnh báo sự cố -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CẢNH BÁO AN TOÀN IOT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblActiveAlerts" Text="0 sự cố" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Giám sát BMS liên tục mỗi 2s" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tiêu đề Sơ đồ 8 ngăn tủ -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SƠ ĐỒ PHẦN CỨNG 8 HỘC TỦ TRẠM SẠC THÔNG MINH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="TỦ 8 NGĂN CÔNG NGHIỆP" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                    </Border>
                </StackPanel>

                <!-- Chú giải LED -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Width="10" Height="10" Background="#10B981" CornerRadius="5" Margin="0,0,4,0"/>
                    <TextBlock Text="Đã đầy" FontSize="12" Margin="0,0,12,0"/>
                    <Border Width="10" Height="10" Background="#F59E0B" CornerRadius="5" Margin="0,0,4,0"/>
                    <TextBlock Text="Đang sạc" FontSize="12" Margin="0,0,12,0"/>
                    <Border Width="10" Height="10" Background="#38BDF8" CornerRadius="5" Margin="0,0,4,0"/>
                    <TextBlock Text="Cửa mở" FontSize="12" Margin="0,0,12,0"/>
                    <Border Width="10" Height="10" Background="#64748B" CornerRadius="5" Margin="0,0,4,0"/>
                    <TextBlock Text="Khay trống" FontSize="12" Margin="0,0,12,0"/>
                    <Border Width="10" Height="10" Background="#EF4444" CornerRadius="5" Margin="0,0,4,0"/>
                    <TextBlock Text="Quá nhiệt / Khóa" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- KHUNG TỦ SẠC CÔNG NGHIỆP 8 HỘC (2 HÀNG x 4 CỘT) -->
            <Border Grid.Row="4" Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="3" Padding="14">
                <ItemsControl x:Name="icSlots">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding MauVienHoc}" BorderThickness="2" Background="{Binding NenKhoangTu}" CornerRadius="12" Margin="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header Ngăn tủ: Số thứ tự + Badge trạng thái cửa -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenHocTu}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding MauTrangThai}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{Binding MauTrangThaiCua}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding TrangThaiCuaText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Khoang hộc tủ chứa pin -->
                                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Visibility="{Binding CoPin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔋 " FontSize="14"/>
                                                    <TextBlock Text="{Binding MaPinHienTai}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LoaiPin, TargetNullValue='Lithium LFP 72V'}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoPin}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="[ KHAY TRỐNG ]" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Sẵn sàng nhận pin" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Progress bar SoC -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <ProgressBar Value="{Binding SoC}" Minimum="0" Maximum="100" Height="7" Foreground="{Binding MauTrangThai}" Background="#1E293B" BorderThickness="0"/>
                                    </Grid>

                                    <!-- Thông số Telemetry BMS -->
                                    <Grid Grid.Row="3" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SoC, StringFormat='SoC: {0:F0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            <TextBlock Text="{Binding SoH, StringFormat='SoH: {0:F0}%'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NhietDo, StringFormat='Nhiệt: {0:F1}°C'}" FontSize="11" FontWeight="Bold" Foreground="{Binding MauNhietDo}"/>
                                            <TextBlock Text="{Binding DongDien, StringFormat='Dòng: {0:F1}A'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Thao tác điều khiển phần cứng ngăn tủ -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Mở cửa hộc" 
                                                Background="#334155" Foreground="White" BorderThickness="0" 
                                                Padding="4,6" FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" Cursor="Hand"
                                                Click="BtnOpenDoor_Click" Tag="{Binding SoThuTu}"/>
                                        <Button Grid.Column="1" Content="Khóa bảo trì" 
                                                Background="#1E293B" Foreground="#F87171" BorderBrush="#EF4444" BorderThickness="1" 
                                                Padding="4,6" FontSize="11" FontWeight="SemiBold" Margin="3,0,0,0" Cursor="Hand"
                                                Click="BtnToggleLock_Click" Tag="{Binding SoThuTu}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
