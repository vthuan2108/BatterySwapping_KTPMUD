<Window x:Class="BatterySwapping.App.Views.Dialogs.AddStationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Trạm Đổi Pin Mới Vào Mạng Lưới" Height="480" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="THÊM TRẠM ĐỔI PIN MỚI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="Mã định danh Trạm (Ví dụ: TRAM-DD03)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMaTram" Style="{StaticResource ModernTextBoxStyle}" Text="TRAM-DD03" Margin="0,0,0,10"/>

                <TextBlock Text="Tên Trạm Đổi Pin" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtTenTram" Style="{StaticResource ModernTextBoxStyle}" Text="Trạm Đổi Pin Đống Đa" Margin="0,0,0,10"/>

                <TextBlock Text="Địa chỉ lắp đặt" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtDiaChi" Style="{StaticResource ModernTextBoxStyle}" Text="Số 1 Đại Cồ Việt, Hai Bà Trưng, Hà Nội" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Tọa độ GPS (Lat, Long)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtToaDoGPS" Style="{StaticResource ModernTextBoxStyle}" Text="21.0070, 105.8450"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Số ngăn tủ" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSoLuongNgan" Style="{StaticResource ModernTextBoxStyle}" Text="8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Trạng thái ban đầu" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cboTrangThai" Height="36" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="HoatDong" IsSelected="True"/>
                    <ComboBoxItem Content="BaoTri"/>
                    <ComboBoxItem Content="TamDung"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy bỏ" Style="{StaticResource OutlineButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Content="Tạo Trạm Mới" Style="{StaticResource PrimaryButtonStyle}" Width="130" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
