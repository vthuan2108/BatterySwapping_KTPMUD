<Window x:Class="BatterySwapping.App.Views.Dialogs.TopUpWalletDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nạp Tiền Vào Ví Đổi Pin" Height="420" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NẠP TIỀN VÀO VÍ KHÁCH HÀNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="Chọn Khách hàng" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cboCustomers" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <TextBlock Text="Số tiền muốn nạp (VNĐ)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtAmount" Style="{StaticResource ModernTextBoxStyle}" Text="100000" Margin="0,0,0,10"/>

                <!-- Nút chọn nhanh số tiền -->
                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Button Content="50.000 đ" Style="{StaticResource OutlineButtonStyle}" Margin="2" Padding="2" Click="BtnQuickAmount_Click" Tag="50000"/>
                    <Button Content="100.000 đ" Style="{StaticResource OutlineButtonStyle}" Margin="2" Padding="2" Click="BtnQuickAmount_Click" Tag="100000"/>
                    <Button Content="200.000 đ" Style="{StaticResource OutlineButtonStyle}" Margin="2" Padding="2" Click="BtnQuickAmount_Click" Tag="200000"/>
                </UniformGrid>

                <TextBlock Text="Phương thức nạp" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cboMethod" Height="36" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Chuyển khoản Ngân hàng (QR Napas 24/7)" Tag="ChuyenKhoan" IsSelected="True"/>
                    <ComboBoxItem Content="Tiền mặt trực tiếp tại quầy" Tag="TienMat"/>
                    <ComboBoxItem Content="Thẻ ghi nợ / Tín dụng" Tag="TheNganHang"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Đóng" Style="{StaticResource OutlineButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Content="Xác Nhận Nạp" Style="{StaticResource PrimaryButtonStyle}" Width="130" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
