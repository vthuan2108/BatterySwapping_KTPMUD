<Window x:Class="BatterySwapping.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập — Hệ Thống Trạm Đổi Pin BSS" 
        Height="590" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Tiêu đề & Logo thương hiệu -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <!-- Biểu tượng trạm pin năng lượng xanh -->
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryLightBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
            <TextBlock Text="Battery Swapping System" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
            <TextBlock Text="HỆ THỐNG VẬN HÀNH TRẠM ĐỔI PIN THÔNG MINH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCategoryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            <TextBlock Text="KTPMUD • Đại học Bách Khoa Hà Nội" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. Form Đăng nhập dạng Card sạch sẽ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="26,22" VerticalAlignment="Top" Background="White">
            <StackPanel>
                <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBoxStyle}" Text="admin" Margin="0,0,0,14"/>

                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBoxStyle}" Password="123456" Margin="0,0,0,12"/>

                <!-- Thông báo lỗi nếu có -->
                <TextBlock x:Name="lblError" Text="" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Nút Đăng nhập dạng Pill Button -->
                <Button x:Name="btnLogin" Content="ĐĂNG NHẬP VẬN HÀNH" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click" Height="42" Margin="0,0,0,10"/>

                <!-- Nút Vào thẳng Kiosk đổi pin -->
                <Button x:Name="btnKioskDirect" Content="Mở Màn Hình Kiosk Tại Trạm" Style="{StaticResource OutlineButtonStyle}" Click="BtnKioskDirect_Click" Height="38"/>

                <!-- Gợi ý tài khoản demo -->
                <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17">
                        <Bold Foreground="{StaticResource TextPrimaryBrush}">Tài khoản kiểm thử demo:</Bold><LineBreak/>
                        • Admin: <Run Text="admin" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/> | Mật khẩu: <Run Text="123456" FontWeight="SemiBold"/><LineBreak/>
                        • Kỹ thuật: <Run Text="tech01" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/> | Mật khẩu: <Run Text="123456" FontWeight="SemiBold"/><LineBreak/>
                        • Khách hàng: <Run Text="driver01" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/> | Mật khẩu: <Run Text="123456" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. Cấu hình chuỗi kết nối Backend API -->
        <Expander Grid.Row="2" Header="Cấu hình kết nối Backend API" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0">
            <StackPanel Margin="0,6,0,0">
                <TextBox x:Name="txtConnString" FontSize="11" Style="{StaticResource ModernTextBoxStyle}" Height="32" Padding="8,4"/>
                <Button Content="Kiểm tra kết nối backend" Style="{StaticResource OutlineButtonStyle}" Margin="0,6,0,0" Padding="8,5" FontSize="11" Click="BtnTestConnection_Click"/>
            </StackPanel>
        </Expander>
    </Grid>
</Window>
