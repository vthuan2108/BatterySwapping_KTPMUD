<Window x:Class="BatterySwapping.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống Quản Lý Mạng Lưới Trạm Đổi Pin Tự Động (BSS) - KTPMUD" 
        Height="760" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- THANH ĐIỀU HƯỚNG BÊN TRÁI (SIDEBAR) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BSS VẬN HÀNH" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="KTPMUD • ĐHBK Hà Nội" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#334155" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Các nút Menu chính -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="PHÂN HỆ CHỨC NĂNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,8"/>

                    <Button x:Name="btnNavOverview" Content="📊  Báo cáo quản trị" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavOverview_Click"/>
                    <Button x:Name="btnNavWallet" Content="💳  Ví và thông tin của tôi" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavWallet_Click"/>
                    <Button x:Name="btnNavKiosk" Content="🖥️  Đổi pin tại trạm" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavKiosk_Click"/>
                    <Button x:Name="btnNavDashboard" Content="🏭  Vận hành trạm" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavDashboard_Click"/>
                    <Button x:Name="btnNavBatteries" Content="🔋  Quản Lý Danh Mục Pin" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavBatteries_Click"/>
                    <Button x:Name="btnNavBusiness" Content="Hồ sơ, kho và thanh toán" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavBusiness_Click"/>
                    <Button x:Name="btnNavCustomers" Content="👥  Khách Hàng &amp; Ví Tiền" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavCustomers_Click"/>
                    <Button x:Name="btnNavTransactions" Content="📜  Giao dịch đổi pin" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavTransactions_Click"/>
                    <Button x:Name="btnNavAlerts" Content="🚨  An toàn và bảo trì" Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavAlerts_Click"/>
                </StackPanel>

                <!-- Thông tin phiên người dùng & Đăng xuất -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblCurrentUserName" Text="Quản trị viên" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <TextBlock x:Name="lblCurrentUserRole" Text="Vai trò: Admin" FontSize="11" Foreground="#10B981"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🚪" ToolTip="Đăng xuất" Style="{StaticResource OutlineButtonStyle}" 
                                BorderThickness="0" Foreground="#F87171" FontSize="16" Padding="6,2" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- VÙNG NỘI DUNG CHÍNH (CONTENT AREA) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh Topbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblSystemStatus" Text="Hệ Thống Trực Tuyến (Online) • CSDL SQL Server Đã Kết Nối" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnEmergencyCutoff" Content="🚨 NGẮT SẠC TOÀN TRẠM KHẨN CẤP" Style="{StaticResource DangerButtonStyle}" 
                                FontSize="12" Padding="12,6" Click="BtnEmergencyCutoff_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khung chuyển đổi UserControl -->
            <ContentControl Grid.Row="1" x:Name="mainContentArea"/>
        </Grid>
    </Grid>
</Window>
