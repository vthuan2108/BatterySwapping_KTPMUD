<Window x:Class="BatterySwapping.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BSS Vận Hành — Hệ Thống Quản Lý Mạng Lưới Trạm Đổi Pin Thông Minh" 
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- THANH ĐIỀU HƯỚNG BÊN TRÁI (MODERN SAAS SIDEBAR) -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" 
                Padding="16,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Logo & Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid Margin="2,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Circular Brand Dot Icon -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" 
                                Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="White"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="bss planner." FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="HUSTFlow • Smart Mobility OS" FontSize="11" Foreground="{StaticResource TextCategoryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,0" Height="1"/>
                </StackPanel>

                <!-- 2. Menu Điều hướng dạng Pill Tabs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Nhóm 1: VẬN HÀNH & GIÁM SÁT -->
                        <TextBlock Text="DANH MỤC" FontSize="10" FontWeight="Bold" 
                                   Foreground="{StaticResource TextCategoryBrush}" Margin="8,4,0,6"/>

                        <Button x:Name="btnNavDashboard" Content="🏭  Vận hành trạm &amp; BMS" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavDashboard_Click"/>
                        <Button x:Name="btnNavOverview" Content="📊  Báo cáo tổng quan" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavOverview_Click"/>
                        <Button x:Name="btnNavTransactions" Content="📜  Phiên &amp; Lịch sử đổi pin" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavTransactions_Click"/>
                        <Button x:Name="btnNavAlerts" Content="🚨  An toàn &amp; Bảo trì IoT" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavAlerts_Click"/>

                        <!-- Nhóm 2: TÀI SẢN & KHO HÀNG -->
                        <TextBlock Text="TÀI SẢN &amp; KHO PIN" FontSize="10" FontWeight="Bold" 
                                   Foreground="{StaticResource TextCategoryBrush}" Margin="8,16,0,6"/>

                        <Button x:Name="btnNavBatteries" Content="🔋  Danh mục pin lưu thông" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavBatteries_Click"/>
                        <Button x:Name="btnNavBusiness" Content="📁  Hồ sơ, kho &amp; đối soát" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavBusiness_Click"/>
                        <Button x:Name="btnNavCustomers" Content="👥  Khách hàng &amp; Ví tiền" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavCustomers_Click"/>

                        <!-- Nhóm 3: TRẢI NGHIỆM ĐỔI PIN -->
                        <TextBlock Text="TRẢI NGHIỆM" FontSize="10" FontWeight="Bold" 
                                   Foreground="{StaticResource TextCategoryBrush}" Margin="8,16,0,6"/>

                        <Button x:Name="btnNavKiosk" Content="🖥️  Kiosk đổi pin tại trạm" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavKiosk_Click"/>
                        <Button x:Name="btnNavWallet" Content="💳  Ví &amp; Thông tin cá nhân" 
                                Style="{StaticResource MenuNavButtonStyle}" Click="BtnNavWallet_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Profile Người dùng & Trạng thái kết nối (Dưới đáy Sidebar) -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar icon tròn -->
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" 
                                Background="{StaticResource PrimaryLightBrush}" Margin="0,0,8,0">
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCurrentUserName" Text="Văn Thuận" FontWeight="SemiBold" 
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="lblCurrentUserRole" Text="Vai trò: Admin" FontSize="11" 
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Nút Đăng xuất dạng icon nhỏ -->
                        <Button Grid.Column="2" Content="🚪" ToolTip="Đăng xuất khỏi hệ thống" 
                                Style="{StaticResource OutlineButtonStyle}" 
                                BorderThickness="0" Background="Transparent" Foreground="#9CA3AF" 
                                FontSize="15" Padding="4,2" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- VÙNG NỘI DUNG CHÍNH (CONTENT AREA & TOPBAR) -->
        <!-- ========================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Thanh Topbar Breadcrumb phong cách Web App -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumbs & Status Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Không gian làm việc" FontSize="13" Foreground="{StaticResource TextCategoryBrush}"/>
                        <TextBlock Text=" / " FontSize="13" Foreground="#D1D5DB" Margin="6,0"/>
                        <TextBlock Text="Vận hành mạng lưới trạm pin" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- Status Chip Pill -->
                        <Border Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                CornerRadius="12" Padding="8,3" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="lblSystemStatus" Text="Trực tuyến • CSDL Đã kết nối" 
                                           FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Topbar Actions & Emergency Cutoff -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                CornerRadius="12" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="2026-11-24" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <Button x:Name="btnEmergencyCutoff" Content="🚨 Ngắt Sạc Khẩn Cấp" 
                                Style="{StaticResource DangerButtonStyle}" 
                                FontSize="12" Padding="12,6" Click="BtnEmergencyCutoff_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Khung hiển thị UserControl Nội dung chính -->
            <Border Grid.Row="1" Background="{StaticResource LightBgBrush}">
                <ContentControl x:Name="mainContentArea"/>
            </Border>
        </Grid>
    </Grid>
</Window>
