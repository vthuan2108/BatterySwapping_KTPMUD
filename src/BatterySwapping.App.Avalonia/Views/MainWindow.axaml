<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BatterySwapping.App.Avalonia.Views.MainWindow"
        Title="⚡ BATTERY SWAPPING SYSTEM (BSS) - KTPMUD"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- THANH ĐIỀU HƯỚNG BÊN TRÁI (SIDEBAR) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,6" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BSS MANAGER" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="KTPMUD • ĐHBK Hà Nội" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#334155" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Các nút Menu Phân hệ Chức năng -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PHÂN HỆ CHỨC NĂNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,8"/>

                        <Button x:Name="btnNavOverview" Content="📊  Tổng quan" Classes="menunav" Click="BtnNavOverview_Click"/>
                        <Button x:Name="btnNavDashboard" Content="🏭  Vận hành trạm" Classes="menunav" Click="BtnNavDashboard_Click"/>
                        <Button x:Name="btnNavBatteries" Content="🔋  Quản lý danh mục pin" Classes="menunav" Click="BtnNavBatteries_Click"/>
                        <Button x:Name="btnNavBusiness" Content="Hồ sơ, kho và thanh toán" Classes="menunav" Click="BtnNavBusiness_Click"/>
                    <Button x:Name="btnNavCustomers" Content="👥  Khách hàng &amp; Ví" Classes="menunav" Click="BtnNavCustomers_Click"/>
                        <Button x:Name="btnNavTransactions" Content="📜  Giao dịch đổi pin" Classes="menunav" Click="BtnNavTransactions_Click"/>
                        <Button x:Name="btnNavAlerts" Content="🚨  An toàn &amp; Bảo trì" Classes="menunav" Click="BtnNavAlerts_Click"/>
                        <Button x:Name="btnNavWallet" Content="💳  Kiosk / Ví cá nhân" Classes="menunav" Click="BtnNavWallet_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thông tin phiên người dùng & Đăng xuất -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCurrentUserName" Text="Quản trị viên" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            <Border x:Name="pnlRolePill" Background="#064E3B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock x:Name="lblCurrentUserRole" Text="Vai trò: Admin" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🚪" ToolTip.Tip="Đăng xuất" Classes="outline"
                                BorderThickness="0" Foreground="#F87171" FontSize="16" Padding="8,4" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- VÙNG NỘI DUNG CHÍNH (CONTENT AREA) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Global In-App Alert Banner (Non-blocking emergency safety notification) -->
            <Border Grid.Row="0" x:Name="pnlEmergencyBanner" Background="#DC2626" Padding="16,10" IsVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🚨" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CẢNH BÁO AN TOÀN IOT KHẨN CẤP!" FontWeight="Bold" FontSize="13" Foreground="White"/>
                        <TextBlock x:Name="txtEmergencyBannerMessage" 
                                   Text="Phát hiện sự cố nhiệt độ quá ngưỡng! Hệ thống đã tự động ngắt sạc và khóa khay tủ." 
                                   FontSize="12" Foreground="#FEE2E2" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Button Content="Xem sự cố" Classes="outline" Background="White" Foreground="#DC2626" FontWeight="Bold" 
                                Padding="10,4" FontSize="11" Click="BtnViewEmergencyAlert_Click"/>
                        <Button Content="✕" Classes="outline" Background="Transparent" Foreground="White" BorderThickness="0" 
                                FontWeight="Bold" FontSize="14" Padding="6,2" Click="BtnDismissAlert_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thanh Topbar -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="lblSystemStatus" Text="Hệ Thống Trực Tuyến (Online) • Backend Sẵn Sàng" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                        <TextBlock x:Name="lblClock" Text="12:00:00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4">
                            <TextBlock x:Name="lblRoleInfo" Text="Chế độ: Đầy đủ quyền" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khung chuyển đổi UserControl linh hoạt -->
            <ContentControl Grid.Row="2" x:Name="mainContentArea"/>
        </Grid>
    </Grid>
</Window>
