<Window x:Class="BatterySwapping.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IoT Station Simulator - Bộ Giả Lập Phần Cứng Trạm Đổi Pin" 
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: TIÊU ĐỀ & CẤU HÌNH KẾT NỐI -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛠️ IOT HARDWARE STATION SIMULATOR" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="BSS VIRTUAL HARDWARE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Giả lập cảm biến nhiệt độ BMS, khay sạc và phản hồi lệnh mở/khóa tủ thời gian thực" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkAutoCharge" Content="⚡ Tự động sạc pin (+1% / 3s)" Foreground="#34D399" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="0,0,16,0" Checked="ChkAutoCharge_Checked" Unchecked="ChkAutoCharge_Unchecked"/>
                    <Button Content="🔄 Quét lại CSDL" Background="#334155" Foreground="White" BorderThickness="0" 
                            Padding="12,6" Cursor="Hand" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KHUNG GIỮA: 2 CỘT (SƠ ĐỒ 8 KHAY & BẢNG ĐIỀU KHIỂN CAN THIỆP) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Sơ đồ 8 ngăn tủ vật lý -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SƠ ĐỒ 8 NGĂN KHAY TRẠM SẠC VẬT LÝ (Click để chọn ngăn can thiệp)" 
                               FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                    <ItemsControl Grid.Row="1" x:Name="icSlots">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334155" BorderThickness="2" CornerRadius="8" Background="#0F172A" Margin="4" Padding="10" Cursor="Hand"
                                        MouseLeftButtonUp="SlotBorder_MouseLeftButtonUp" Tag="{Binding SoThuTu}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding SoThuTu, StringFormat='NGĂN #{0}'}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                        <TextBlock Grid.Row="1" Text="{Binding MaPinHienTai, TargetNullValue='[TRỐNG]'}" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" Margin="0,4,0,2"/>
                                        
                                        <!-- SoC & Temp -->
                                        <StackPanel Grid.Row="2" Margin="0,4,0,6">
                                            <TextBlock Text="{Binding SoC, StringFormat='SoC: {0:F0}%'}" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding NhietDo, StringFormat='Nhiệt: {0:F1}°C'}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </StackPanel>

                                        <!-- Badge Cửa & Khóa -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                                            <Border Background="{Binding CuaBackground}" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding CuaText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="{Binding KhoaBackground}" CornerRadius="4" Padding="4,2">
                                                <TextBlock Text="{Binding KhoaText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Cột phải: Bảng can thiệp thông số phần cứng -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="18" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="lblSelectedSlotTitle" Text="ĐIỀU KHIỂN CAN THIỆP: NGĂN TỦ #1" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,14"/>

                    <!-- Slider Nhiệt độ (20 - 80 độ C) -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Nhiệt độ cảm biến (°C):" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="lblTempSliderVal" Text="28.0 °C" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="sliderTemp" Minimum="20" Maximum="80" Value="28" ValueChanged="SliderTemp_ValueChanged" Margin="0,0,0,16"/>

                    <!-- Slider Dung lượng SoC (0 - 100%) -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Dung lượng pin SoC (%):" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="lblSocSliderVal" Text="98 %" FontSize="13" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="sliderSoc" Minimum="0" Maximum="100" Value="98" ValueChanged="SliderSoc_ValueChanged" Margin="0,0,0,16"/>

                    <!-- Nút cập nhật thông số -->
                    <Button Content="💾 ÁP DỤNG THÔNG SỐ VÀO CSDL" Background="#0284C7" Foreground="White" FontWeight="Bold" 
                            Height="38" BorderThickness="0" Margin="0,0,0,12" Cursor="Hand" Click="BtnApplyParams_Click"/>

                    <Separator Background="#334155" Margin="0,4,0,12"/>

                    <!-- Nút Cắm / Rút pin -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button x:Name="btnToggleInsert" Content="Cắm pin vào khay" Background="#334155" Foreground="White" 
                                Height="34" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" Click="BtnToggleInsert_Click"/>
                        <Button x:Name="btnToggleDoor" Content="Mở / Đóng cửa" Background="#334155" Foreground="White" 
                                Height="34" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" Click="BtnToggleDoor_Click"/>
                    </UniformGrid>

                    <!-- NÚT GIẢ LẬP SỰ CỐ QUÁ NHIỆT KHẨN CẤP (ĐÂY LÀ CHỨC NĂNG ĂN ĐIỂM BÁO CÁO) -->
                    <Button Content="🔥 KÍCH HOẠT QUÁ NHIỆT (65°C)" Background="#DC2626" Foreground="White" FontWeight="Bold" 
                            Height="44" BorderThickness="0" Margin="0,8,0,0" Cursor="Hand" Click="BtnEmergencyHeat_Click"/>
                    <TextBlock Text="*Đẩy nhiệt độ lên 65°C để kích hoạt còi báo động và ngắt sạc khẩn cấp trên màn hình chính." 
                               FontSize="10" Foreground="#F87171" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- VÙNG DƯỚI: CONSOLE NHẬT KÝ TELEMETRY THỜI GIAN THỰC -->
        <Border Grid.Row="2" Background="#050914" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📟 LIVE TELEMETRY BUS LOG (CONSOLE)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="txtLog" Background="Transparent" Foreground="#34D399" BorderThickness="0" 
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
